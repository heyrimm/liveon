# 이 파일을 .env.local 로 복사하고 실제 값을 넣어주세요.
# Railway PostgreSQL의 public/TCP proxy 연결 문자열을 사용합니다.
DATABASE_URL=postgresql://postgres:password@host:port/railway

# `npx auth@latest secret`으로 생성합니다. 운영 환경에서는 반드시 별도 값을 사용하세요.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# 키가 없어도 채팅 데모는 미리 준비된 폴백 응답으로 동작합니다.
ANTHROPIC_API_KEY=sk-ant-...

# /meshy의 Image to 3D 생성에서 사용 — 브라우저에는 노출되지 않습니다.
MESHY_API_KEY=msy_...

# scripts/generate-3d-asset.mjs (npm run gen3d) 에서만 사용 — fal.ai 대시보드에서 발급
FAL_KEY=...
